PORT=3000
REDIS_URL=redis://127.0.0.1:6380
MEILI_URL=http://127.0.0.1:7700
# Generate a private key of at least 16 bytes; never expose it to Vite/browser.
MEILI_MASTER_KEY=replace-with-a-random-private-key

# Cấu hình PostgreSQL (Chạy Docker trên cổng riêng 5438)
PGHOST=localhost
PGPORT=5438
PGUSER=linime_user
PGPASSWORD=linime_secure_pass_2026
PGDATABASE=linime_db

DATABASE_URL=postgresql://linime_user:linime_secure_pass_2026@localhost:5438/linime_db

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Danh sách email Admin (cách nhau bởi dấu phẩy)
ADMIN_EMAILS=admin@anidoki.com
